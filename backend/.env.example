# SHARESPACE Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="SHARESPACE"
APP_VERSION="0.1.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="INFO"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
# PostgreSQL connection string for the application (uses app role, no BYPASSRLS)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL="postgresql+asyncpg://sharespace_app:changeme@localhost:5432/sharespace"

# Separate connection for migrations (uses migration role with BYPASSRLS)
DATABASE_MIGRATION_URL="postgresql+asyncpg://sharespace_migrate:changeme@localhost:5432/sharespace"

# For synchronous operations (Alembic)
SYNC_DATABASE_URL="postgresql://sharespace_migrate:changeme@localhost:5432/sharespace"

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY="changeme-generate-a-secure-random-key-32-bytes-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Login (disable in production!)
ENABLE_DEMO_LOGIN=true
DEMO_DEFAULT_ORG_ID="org_nit"

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# OIDC Configuration (Tier 2 - optional)
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI=""

# Object Storage (Tier 2 - optional, for evidence attachments)
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""
OBJECT_STORAGE_REGION=""

# AI Services (Tier 2 - optional)
GEMINI_API_KEY=""

# Monitoring (optional)
SENTRY_DSN=""

# Rate Limiting (requests per minute)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=10
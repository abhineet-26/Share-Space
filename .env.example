# GEMINI_API_KEY: Required for optional server-side Gemini AI assistive features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_MODE: 'mock' (default local storage deterministic engine) or 'live' (FastAPI /api/v1 backend)
VITE_API_MODE="mock"
VITE_API_BASE_URL=""
VITE_ENABLE_AI="false"
